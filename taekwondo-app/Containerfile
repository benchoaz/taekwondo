# Containerfile untuk Next.js Taekwondo App (Kompatibel dengan Podman Rootless)

FROM node:20-alpine AS base

# Install openssl untuk engines Prisma & wget untuk healthcheck
RUN apk add --no-cache openssl wget

# Setup dependencies
FROM base AS deps
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Builder stage
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma Client & Build
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL="postgresql://taekwondo_user:taekwondo_password@localhost:5432/taekwondo_academy"
RUN npx prisma generate
RUN npm run build

# Runner stage - salin seluruh /app utuh dari builder
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3030
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app ./

USER nextjs

EXPOSE 3030

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3030/ || exit 1

CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3030", "-H", "0.0.0.0"]
